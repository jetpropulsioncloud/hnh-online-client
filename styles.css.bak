:root{
  --paper:#f6f0df;--paper2:#fffaf0;--ink:#26362c;--muted:#6d756d;--line:#b6a77e;
  --green:#5b7253;--amber:#b77c2f;--root:#79634f;--danger:#9e4e43;--blue:#557a83;
  --shadow:0 8px 24px rgba(38,54,44,.12);
}
*{box-sizing:border-box}body{margin:0;background:#ded7c4;color:var(--ink);font:15px/1.35 ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
button,select{font:inherit}.app{max-width:1500px;margin:auto;padding:18px}.topbar{display:flex;gap:14px;align-items:center;justify-content:space-between;background:var(--paper2);padding:12px 16px;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);position:sticky;top:8px;z-index:20}.brand{font-family:Georgia,serif;font-size:22px;font-weight:800}.beta{font-size:12px;color:var(--amber);font-weight:800}.turnbox{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.pill{padding:5px 9px;border-radius:999px;background:#eee6d2;border:1px solid #d4c8a8;font-size:12px}.pill.active{background:var(--green);color:white;border-color:var(--green)}button{background:var(--green);color:white;border:0;border-radius:9px;padding:8px 11px;cursor:pointer;font-weight:700}button:hover{filter:brightness(1.06)}button.secondary{background:#7e816f}button.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}button.danger{background:var(--danger)}button:disabled{opacity:.42;cursor:not-allowed;filter:none}.layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;margin-top:14px}.main{display:grid;gap:14px}.side{display:grid;gap:14px;align-content:start}.panel{background:var(--paper2);border:1px solid var(--line);border-radius:16px;padding:12px;box-shadow:var(--shadow)}.panel h2,.panel h3{font-family:Georgia,serif;margin:0 0 8px}.playerHeader{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.stats{display:flex;gap:8px;flex-wrap:wrap}.stat{background:#f0e7d3;border:1px solid #d4c8a8;padding:5px 8px;border-radius:9px;font-weight:800}.resrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.resource{display:flex;align-items:center;gap:5px;background:#f3ead8;border:1px solid #d5c7a1;border-radius:10px;padding:4px 6px}.resource button{padding:2px 7px;border-radius:7px;background:#8b866f}.resource strong{min-width:18px;text-align:center}.village{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:9px}.card{background:var(--paper);border:1px solid #918a70;border-radius:12px;padding:9px;position:relative;min-height:135px}.card.ruined{opacity:.64;background:#e9dfd5}.card.tired{transform:rotate(1.4deg);box-shadow:inset 0 0 0 3px rgba(158,78,67,.22)}.card.attacking{box-shadow:inset 0 0 0 3px rgba(183,124,47,.45)}.card.blocking{box-shadow:inset 0 0 0 3px rgba(85,122,131,.45)}.card .title{font-family:Georgia,serif;font-size:16px;font-weight:800;line-height:1.15}.type{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:3px 0 6px}.rules{font-size:12px;color:#3f4c43;margin-top:5px}.tags{font-size:11px;color:#64736a}.numbers{font-weight:800;margin:4px 0;font-size:12px}.actions{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.actions button,.actions select{font-size:11px;padding:5px 7px}.actions select{max-width:100%;border:1px solid var(--line);background:white;border-radius:7px;color:var(--ink)}.tiny{font-size:10px;color:var(--muted)}.manual{font-size:10px;background:#f3dba8;color:#704d15;border-radius:6px;padding:2px 5px;display:inline-block;margin-top:5px}.hand{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}.hand .card{min-width:190px;max-width:190px}.blueprints{display:grid;gap:7px}.bp{display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center;border-bottom:1px dashed #c8b992;padding:6px 0}.bp:last-child{border-bottom:0}.bpname{font-weight:800}.cost{font-size:12px;color:#5f5949}.log{max-height:250px;overflow:auto;font-size:12px;background:#f5eedf;border-radius:10px;padding:8px}.log div{padding:3px 0;border-bottom:1px dotted #d6c9ab}.log div:last-child{border:0}.combat{background:#efe7d5;border:1px solid #cbb98c;border-radius:12px;padding:9px;margin-top:8px}.notice{background:#f5e8c4;border:1px solid #d9bb6c;border-radius:10px;padding:8px;margin:8px 0}.win{background:#dcead7;border-color:#80a375}.passOverlay{position:fixed;inset:0;background:rgba(28,33,29,.88);display:flex;align-items:center;justify-content:center;z-index:99}.passCard{background:var(--paper2);border:1px solid var(--line);border-radius:20px;padding:28px;max-width:430px;text-align:center;box-shadow:var(--shadow)}.passCard h1{font-family:Georgia,serif}.setup{max-width:900px;margin:70px auto;background:var(--paper2);padding:28px;border-radius:22px;border:1px solid var(--line);box-shadow:var(--shadow)}.setup h1{font:800 42px/1 Georgia,serif;margin:0}.setupGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0}.choice{border:2px solid #c8b994;border-radius:15px;padding:18px;background:var(--paper)}.choice h3{font-family:Georgia,serif;margin-top:0}.footerNote{font-size:12px;color:var(--muted);margin-top:14px}.divider{height:1px;background:#d8ccb0;margin:8px 0}.kbd{font-family:ui-monospace,monospace;background:#ece4d2;border:1px solid #d4c6a4;border-radius:5px;padding:1px 4px}.residentList{display:grid;gap:6px}.resident{border-left:3px solid #9e916e;padding-left:6px}.resident.inactive{opacity:.55}.targetline{display:grid;grid-template-columns:1fr auto;gap:5px}.smallSelect{width:100%;min-width:0}
@media(max-width:1000px){.layout{grid-template-columns:1fr}.side{grid-template-columns:1fr 1fr}.topbar{position:static}}@media(max-width:680px){.setupGrid,.side{grid-template-columns:1fr}.app{padding:8px}.topbar{align-items:flex-start}.village{grid-template-columns:1fr 1fr}.hand .card{min-width:170px}.brand{font-size:18px}}

/* v0.2 interaction pass */
.pill small{font-size:9px;opacity:.7;margin-left:2px}.pill.done{opacity:.68}.pill.done::after{content:' ✓';font-weight:900}.dragHint{margin:9px 0 11px;padding:8px 10px;border:1px dashed #b9a36e;border-radius:10px;background:#fbf4df;font-size:12px;color:#625a46}.musterAccept{font-size:11px;border-radius:7px;padding:5px 6px;margin:5px 0;background:#ece3cf}.musterAccept span{color:var(--muted)}.homeHint{font-size:10px;padding:6px;margin:5px 0;background:#e7eedf;border:1px solid #bdc9ad;border-radius:8px}.homeHint span{color:var(--muted)}.homeHint.noHome{background:#f1e6dc;border-color:#d3b9a7}.handCard.isDraggable,.bpDraggable,.draggableResident{cursor:grab}.handCard.isDraggable:active,.bpDraggable:active,.draggableResident:active{cursor:grabbing}.draggingSource{opacity:.45}.buildingCard,.resident,.bp,.hearthStat,.playerPanel{transition:box-shadow .14s ease,opacity .14s ease,transform .14s ease,border-color .14s ease}.dropOk{box-shadow:inset 0 0 0 4px rgba(83,125,73,.65),0 0 0 2px rgba(83,125,73,.15)!important;transform:translateY(-2px)}.dropMaybe{box-shadow:inset 0 0 0 4px rgba(183,124,47,.58)!important}.dropBad{opacity:.42}.villageDropReady{box-shadow:inset 0 0 0 4px rgba(91,114,83,.28)}.toolTargetReady{box-shadow:inset 0 0 0 3px rgba(85,122,131,.5);border-radius:7px}.attackTargetReady{box-shadow:inset 0 0 0 4px rgba(183,124,47,.62)!important;transform:translateY(-2px)}.attackDrop{position:relative}.attackDrop::after{content:'drag attack here';position:absolute;right:7px;top:6px;font-size:9px;text-transform:uppercase;letter-spacing:.05em;color:#9a6a27;opacity:0}.attackTargetReady::after{opacity:1}.gainBurst{position:absolute;z-index:8;left:50%;top:6px;transform:translateX(-50%);font-weight:900;font-size:20px;color:#42603c;background:rgba(255,250,240,.94);border:1px solid #b8c7a8;border-radius:999px;padding:4px 9px;pointer-events:none;animation:hnhGain 1.3s ease-out forwards;white-space:nowrap}@keyframes hnhGain{0%{opacity:0;transform:translate(-50%,12px) scale(.8)}20%{opacity:1;transform:translate(-50%,0) scale(1.08)}75%{opacity:1}100%{opacity:0;transform:translate(-50%,-28px) scale(.96)}}.resourcePulse{animation:hnhPulse .7s ease-out}@keyframes hnhPulse{0%{transform:scale(1)}40%{transform:scale(1.08);box-shadow:0 0 0 3px rgba(91,114,83,.16)}100%{transform:scale(1)}}.resLabel{font-size:10px;color:var(--muted)}.choiceOverlay{position:fixed;inset:0;background:rgba(28,33,29,.76);display:flex;align-items:center;justify-content:center;z-index:120;padding:18px}.choiceCard{width:min(520px,100%);background:var(--paper2);border:1px solid var(--line);border-radius:20px;padding:24px;text-align:center;box-shadow:var(--shadow)}.choiceCard h2{font-family:Georgia,serif;margin:4px 0}.resourceChoices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:18px 0}.resourceChoice{display:flex;flex-direction:column;gap:6px;align-items:center;justify-content:center;min-height:98px;background:#efe6d3;color:var(--ink);border:2px solid #c9b98f}.resourceChoice span{font-size:34px}.resourceChoice:hover{background:#e6dcc6;border-color:var(--green)}.combatHint{margin:0}.emptyResident{padding-top:4px}.bpDisabled{opacity:.5}.fallbackAction{opacity:.78}.attackRow{padding:8px 0}
@media(max-width:680px){.resourceChoices{grid-template-columns:1fr}.resLabel{display:none}.dragHint{display:none}}
@media(prefers-reduced-motion:reduce){.gainBurst,.resourcePulse{animation:none}}


/* v0.3 solo AI pass */
.setupActions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.aiChoice{border-color:#9aa88f;background:#edf1e7}.aiBadge{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#e4eadf;border:1px solid #a8b59e;color:#40513c;font-size:11px;font-weight:900;letter-spacing:.03em}.aiTurnPanel{border-style:dashed}.aiThinking{display:flex;align-items:center;gap:10px;padding:6px}.aiThinking h3{margin:0 0 3px}.aiDot{width:12px;height:12px;border-radius:50%;background:var(--green);animation:aiThink 1s ease-in-out infinite}.aiCombat{border-color:#9aa88f;background:#e8edde}.aiChoiceOverlay .choiceCard{max-width:400px}.opponentPanel .dragHint{display:none}@keyframes aiThink{0%,100%{transform:scale(.75);opacity:.45}50%{transform:scale(1.18);opacity:1}}@media(prefers-reduced-motion:reduce){.aiDot{animation:none}}

/* v0.3.1 faction choice + finite Blueprint feedback */
.setupPrompt{font-family:Georgia,serif;margin:24px 0 10px}.factionSelect{align-items:stretch}.factionButton{width:100%;min-height:150px;text-align:left;background:var(--paper);color:var(--ink);border:2px solid #c8b994;border-radius:15px;padding:18px;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:13px;row-gap:8px;align-items:center}.factionButton:hover{filter:none;background:#efe8d6;border-color:var(--green);transform:translateY(-1px)}.factionButton .choiceIcon{font-size:30px;grid-row:1 / span 2}.factionButton strong{display:block;font:800 18px/1.2 Georgia,serif}.factionButton small{display:block;margin-top:6px;color:var(--muted);font-weight:500}.choicePlay{grid-column:2;font-size:12px;font-weight:800;color:var(--green)}.setupNote{background:#f4ecd9;border:1px solid #d3c39e;border-radius:11px;padding:10px 12px;margin:2px 0 16px}.bpUsed{opacity:.55;background:#eee7d8}.usedTag{display:inline-block;margin-left:5px;padding:1px 5px;border:1px solid #bcae8b;border-radius:999px;font:800 9px/1.5 ui-sans-serif,system-ui;color:var(--muted);vertical-align:2px}.bpUsed button{background:#8d8b7e}
@media(max-width:680px){.factionButton{min-height:120px}}

/* v0.3.2 fixed POV + recruit timing */
.freshTag{display:inline-block;margin-left:4px;padding:1px 5px;border-radius:999px;background:#e7eedf;border:1px solid #bdc9ad;color:#4d6545;font:800 9px/1.5 ui-sans-serif,system-ui;vertical-align:1px}.handLocked{opacity:.72;cursor:default}.handLocked .homeHint{opacity:.75}.aiTurnNotice{margin:0 0 10px;background:#e8edde;border-color:#aebba5}.opponentPanel{order:initial}.activePlayerPanel{order:initial}

/* v0.3.3 layout containment hotfix */
.layout{grid-template-columns:minmax(0,1fr) minmax(280px,320px);align-items:start}
.main,.side,.panel,.playerHeader,.hand,.village,.blueprints,.bp{min-width:0}
.main{width:100%;overflow:visible}
.side{width:100%;max-width:100%;overflow:hidden}
.panel{max-width:100%}
.playerHeader{flex-wrap:wrap}
.playerHeader .stats{margin-left:auto;max-width:100%}
.village{width:100%;grid-template-columns:repeat(auto-fill,minmax(min(190px,100%),1fr))}
.hand{width:100%;max-width:100%;min-width:0;overflow-x:auto;overscroll-behavior-x:contain}
.bp{grid-template-columns:minmax(0,1fr) auto}
.bp>div{min-width:0}
.bpname,.cost{overflow-wrap:anywhere}
.log{max-width:100%}
@media(max-width:1120px){
  .layout{grid-template-columns:1fr}
  .side{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;overflow:visible}
  .side>section:first-child{grid-column:1 / -1}
  .topbar{position:static}
}
@media(max-width:720px){
  .side{grid-template-columns:1fr}
  .side>section:first-child{grid-column:auto}
  .village{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .village{grid-template-columns:1fr}
}
